# Copy to .env in the repository root (or backend/). All values are optional;
# the defaults below match docker-compose.yml and a local Ollama.

# PostgreSQL with pgvector (docker compose maps it to host port 5434).
DATABASE_URL=postgresql+psycopg://tutor:tutor_password@localhost:5434/adaptive_tutor

# Browser origins allowed to call the API directly (comma-separated).
# Not needed in development, where the Vite proxy is used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama serves both the LLM and the embedding model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Signs login tokens. Use a long random value; if empty, a new key is
# generated at every start and everyone is signed out on restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=720

# Optional: create (or promote) this admin at start-up.
ADMIN_USERNAME=
ADMIN_PASSWORD=
