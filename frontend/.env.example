# Copy to .env.local to override. All values are optional.

# Where the frontend sends API requests.
#   /api  (default)  goes through the Vite dev proxy below - no CORS needed.
#   Use a full URL (e.g. https://tutor.example.com) when the backend is
#   served from another origin; add that origin to CORS_ORIGINS on the backend.
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
